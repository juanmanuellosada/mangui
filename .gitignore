# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# but do track the example file
!.env.example

# PWA generated files (sw.js es estático y se commitea; workbox-*.js sería generado)
/public/workbox-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated design mockups (large PNGs — keep folder via .gitkeep)
/design-mockups/*.png

# brand/ source PNGs are committed as brand assets — do NOT ignore them

# QA / mockups (no versionar imágenes)
design-mockups/**/*.png
