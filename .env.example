# ============================================================
# mangui — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only (used in Server Actions, API Routes, cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (transactional email) ────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" address shown to recipients (domain must be verified in Resend)
RESEND_FROM_EMAIL=mangui <hola@mangui.com.ar>

# ── Web Push (VAPID keys) ───────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hola@mangui.com.ar

# ── IA (servidor) ───────────────────────────────────────────
# API key de Google Generative AI para la IA incluida (gemini-2.5-flash).
# Generá una en: https://aistudio.google.com/apikey
# En producción: setear en Vercel como variable de entorno del servidor.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Cron jobs ───────────────────────────────────────────────
# Optional: protect /api/cron/refresh-rates
# Vercel Cron passes this as: Authorization: Bearer <CRON_SECRET>
# Leave empty to run without auth (not recommended in production)
CRON_SECRET=

# ── App config ──────────────────────────────────────────────
# Canonical site URL — used for metadata/OG tags (metadataBase in layout.tsx)
# In production set this to https://mangui.com.ar; leave as localhost for local dev
NEXT_PUBLIC_SITE_URL=https://mangui.com.ar
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Argentina timezone (used for date calculations server-side)
TZ=America/Argentina/Buenos_Aires
