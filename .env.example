# ============================================================
# mangui — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only (used in Server Actions, API Routes, cron jobs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Resend (transactional email) ────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# The "from" email address (must be a verified domain in Resend)
RESEND_FROM_EMAIL=hola@mangui.app

# ── Web Push (VAPID keys) ───────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hola@mangui.app

# ── Vercel AI Gateway ───────────────────────────────────────
# Used by the Vercel AI SDK for model routing / caching
# See: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=your-ai-gateway-key
# Or if using direct provider keys:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cron jobs ───────────────────────────────────────────────
# Optional: protect /api/cron/refresh-rates
# Vercel Cron passes this as: Authorization: Bearer <CRON_SECRET>
# Leave empty to run without auth (not recommended in production)
CRON_SECRET=

# ── App config ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Argentina timezone (used for date calculations server-side)
TZ=America/Argentina/Buenos_Aires
